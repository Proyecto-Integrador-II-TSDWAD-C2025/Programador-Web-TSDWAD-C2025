# Django Configuration
# Generar un valor propio con get_random_secret_key (ver README).
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=proyectointegrador
DB_USER=nutriapp
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Origenes del frontend: esquema y puerto, sin slash final. No afecta a Android.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Solo True detras de un proxy confiable que controle X-Forwarded-Proto (Railway).
TRUST_X_FORWARDED_PROTO=False
# En produccion, DEBUG=False activa HTTPS y cookies seguras por defecto.
# SECURE_SSL_REDIRECT=True
